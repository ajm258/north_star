ENVIRONMENT=development
DATABASE_URL=postgresql+psycopg://portfolio:portfolio@db:5432/portfolio_intelligence
ADMIN_USERNAME=admin
# Supply through a secret manager or local .env file; never commit a real password.
ADMIN_PASSWORD=replace-with-a-strong-local-password
LOG_LEVEL=INFO
UPLOAD_MAX_BYTES=5242880
DEFAULT_PORTFOLIO_TIMEZONE=Europe/London
